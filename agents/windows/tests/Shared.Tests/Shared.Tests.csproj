<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Platform-neutral tests: runs on any OS including macOS CI -->
    <!-- Test projects target net10.0 to match available runtime; Shared targets net8.0 for Windows deployment -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Patched.Shared.Tests</RootNamespace>
    <!-- Assembly name must match Shared's InternalsVisibleTo (PAT-310). -->
    <AssemblyName>Patched.Shared.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Reference Shared without the Windows TFM so it builds on macOS CI -->
    <ProjectReference Include="..\..\src\Shared\Shared.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!--
      PAT-1959: copy the device-class contract files next to the test binary so
      DeviceClassContractFileTests finds them at AppContext.BaseDirectory on the first
      step of its walk-up, whatever the runner's working directory or checkout layout.
      The drift guard those tests provide is worth keeping, but it must not be able to
      turn a build red because a runner was laid out differently. Copied from the repo
      source on every build, so the copy cannot go stale against contracts/.
    -->
    <None Include="..\..\..\contracts\inventory-device-class*.json"
          Link="contracts\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <!-- PAT-2065: the vendored platform schema BrowserExtensionsStatusContract validates against. -->
    <None Include="..\..\..\contracts\inventory-browser-extensions-status.schema.json"
          Link="contracts\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- Ed25519 test vectors sign with BouncyCastle to mirror the verifier (PAT-310). -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.4.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
</Project>
