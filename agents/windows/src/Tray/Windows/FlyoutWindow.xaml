<Window x:Class="Patched.Tray.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Patched.Tray"
        Title="Patched"
        Width="352"
        SizeToContent="Height"
        MinWidth="320"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        Topmost="True"
        ShowInTaskbar="False"
        Deactivated="Window_Deactivated">

    <!-- Mica-style backdrop applied in code-behind via DwmSetWindowAttribute -->

    <Window.Resources>
        <!-- System font — Segoe UI Variable on Win11, Segoe UI on Win10 -->
        <FontFamily x:Key="SysFont">Segoe UI Variable Text, Segoe UI, sans-serif</FontFamily>
        <!-- Cascadia Mono for evidence (versions, CVE IDs, hashes) -->
        <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, monospace</FontFamily>

        <!-- Brand palette -->
        <Color x:Key="SignalOrange">#F5530A</Color>
        <Color x:Key="Slate">#1B1B1B</Color>
        <Color x:Key="Graphite">#383838</Color>
        <Color x:Key="Mute">#6A6A6A</Color>
        <Color x:Key="SecureGreen">#1A8A4E</Color>
        <Color x:Key="CriticalRed">#D13438</Color>
        <Color x:Key="IdleGray">#8A8D94</Color>
        <Color x:Key="DividerLine">#1A000000</Color>

        <SolidColorBrush x:Key="SignalBrush"   Color="{StaticResource SignalOrange}"/>
        <SolidColorBrush x:Key="SlateBrush"    Color="{StaticResource Slate}"/>
        <SolidColorBrush x:Key="GraphiteBrush" Color="{StaticResource Graphite}"/>
        <SolidColorBrush x:Key="MuteBrush"     Color="{StaticResource Mute}"/>
        <SolidColorBrush x:Key="SecureBrush"   Color="{StaticResource SecureGreen}"/>
        <SolidColorBrush x:Key="CriticalBrush" Color="{StaticResource CriticalRed}"/>
        <SolidColorBrush x:Key="IdleBrush"     Color="{StaticResource IdleGray}"/>

        <!-- Surface: near-white, slightly warm — matches Mica light -->
        <SolidColorBrush x:Key="SurfaceBrush"  Color="#F3F3F1"/>

        <!-- Subtle button style -->
        <Style x:Key="SubtleButton" TargetType="Button">
            <Setter Property="Background"        Value="Transparent"/>
            <Setter Property="BorderThickness"   Value="0"/>
            <Setter Property="Cursor"            Value="Hand"/>
            <Setter Property="FontFamily"        Value="{StaticResource SysFont}"/>
            <Setter Property="HorizontalAlignment"        Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding"           Value="10,0"/>
            <Setter Property="Height"            Value="36"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#10000000"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#18000000"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Neutral outlined button -->
        <Style x:Key="NeutralButton" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderBrush"     Value="#30000000"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="Padding"         Value="14,0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontFamily"      Value="{StaticResource SysFont}"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Foreground"      Value="{StaticResource SlateBrush}"/>
        </Style>
    </Window.Resources>

    <!-- Drop-shadow border -->
    <Border CornerRadius="8"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="#28000000"
            BorderThickness="1"
            Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270"
                              Color="#000000" Opacity="0.14"/>
        </Border.Effect>

        <!-- Flyout content — built in code-behind, hosted here -->
        <ContentPresenter x:Name="FlyoutHost" Margin="14"/>
    </Border>
</Window>
