<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.patched.upload</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Library/Patched/patched-upload.sh</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>StartInterval</key>
    <integer>900</integer>

    <key>StandardOutPath</key>
    <string>/var/log/patched-upload.out</string>

    <key>StandardErrorPath</key>
    <string>/var/log/patched-upload.err</string>

    <!-- Drop low-priority IO bands so we don't compete with the user's foreground tasks -->
    <key>LowPriorityIO</key>
    <true/>
    <key>Nice</key>
    <integer>10</integer>
</dict>
</plist>
