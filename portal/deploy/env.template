# Patched customer portal — /etc/patched-portal/env
# Copied into place by deploy/install.sh on first run; never committed with
# real values. chmod 640 root:portal.

# Cloudflare Access team domain (Zero Trust -> Settings -> Custom Pages
# shows "<team>.cloudflareaccess.com"). No scheme.
PORTAL_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com

# The AUD tag of the app.patched.im Access application.
# Zero Trust -> Access -> Applications -> app.patched.im -> Overview -> Application Audience (AUD) Tag.
PORTAL_ACCESS_AUD=

# Platform read API base. The portal only ever calls /v1/portal/* on it.
PLATFORM_BASE_URL=https://api.patched.im
