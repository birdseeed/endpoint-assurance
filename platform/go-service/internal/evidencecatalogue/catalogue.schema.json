{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patched.im/schemas/installation-evidence-catalogue/v1",
  "title": "Patched installation-confidence evidence catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalogue_version", "published_at", "entries"],
  "properties": {
    "schema_version": {"const": 1},
    "catalogue_version": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
    "published_at": {"type": "string", "format": "date-time"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "rationale", "canonical_identity", "platform", "stable_identifiers", "permitted_paths", "expected_signer", "sources", "review"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
        "rationale": {"type": "string", "minLength": 1},
        "canonical_identity": {"$ref": "#/$defs/canonicalIdentity"},
        "platform": {"enum": ["macos", "windows"]},
        "stable_identifiers": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/stableIdentifier"}
        },
        "permitted_paths": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "expected_signer": {"$ref": "#/$defs/signer"},
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/source"}
        },
        "review": {"$ref": "#/$defs/review"}
      },
      "allOf": [
        {
          "if": {"properties": {"platform": {"const": "macos"}}, "required": ["platform"]},
          "then": {
            "properties": {
              "stable_identifiers": {"items": {"properties": {"kind": {"const": "bundle_id"}}}},
              "permitted_paths": {"items": {"pattern": "^/Applications/"}},
              "expected_signer": {"properties": {"kind": {"const": "apple_team_id"}}},
              "review": {
                "properties": {"method": {"const": "codesign_bundle_inspection"}},
                "required": ["code_directory_hash"],
                "not": {"required": ["artifact_sha256"]}
              }
            }
          }
        },
        {
          "if": {"properties": {"platform": {"const": "windows"}}, "required": ["platform"]},
          "then": {
            "properties": {
              "stable_identifiers": {"items": {"properties": {"kind": {"enum": ["winget_id", "msi_upgrade_code", "msix_package_family_name"]}}}},
              "permitted_paths": {"items": {"pattern": "^[A-Za-z]:\\\\"}},
              "expected_signer": {"properties": {"kind": {"const": "authenticode_subject"}}},
              "review": {
                "properties": {"method": {"const": "authenticode_artifact_inspection"}},
                "required": ["artifact_sha256"],
                "not": {"required": ["code_directory_hash"]}
              }
            }
          }
        }
      ]
    },
    "canonicalIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product_key", "product_name", "vendor_name"],
      "properties": {
        "product_key": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
        "product_name": {"type": "string", "minLength": 1},
        "vendor_name": {"type": "string", "minLength": 1}
      }
    },
    "stableIdentifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {"enum": ["bundle_id", "winget_id", "msi_upgrade_code", "msix_package_family_name"]},
        "value": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "bundle_id"}}, "required": ["kind"]},
          "then": {"properties": {"value": {"pattern": "^[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)*$"}}}
        },
        {
          "if": {"properties": {"kind": {"const": "winget_id"}}, "required": ["kind"]},
          "then": {"properties": {"value": {"maxLength": 128, "allOf": [
            {"pattern": "^[^\\.\\s\\\\/:*?\"<>|\\u0001-\\u001f]{1,32}(\\.[^\\.\\s\\\\/:*?\"<>|\\u0001-\\u001f]{1,32}){1,7}$"},
            {"pattern": "^[^\\x00]+$"}
          ]}}}
        },
        {
          "if": {"properties": {"kind": {"const": "msi_upgrade_code"}}, "required": ["kind"]},
          "then": {"properties": {"value": {"pattern": "^\\{[0-9A-F]{8}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{12}\\}$"}}}
        },
        {
          "if": {"properties": {"kind": {"const": "msix_package_family_name"}}, "required": ["kind"]},
          "then": {"properties": {"value": {"maxLength": 64, "pattern": "^[A-Za-z0-9.-]{3,50}_[A-HJ-KM-NP-TV-Za-hj-km-np-tv-z0-9]{13}$"}}}
        }
      ]
    },
    "signer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {"enum": ["apple_team_id", "authenticode_subject"]},
        "value": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "apple_team_id"}}, "required": ["kind"]},
          "then": {"properties": {"value": {"pattern": "^[A-Z0-9]{10}$"}}}
        },
        {
          "if": {"properties": {"kind": {"const": "authenticode_subject"}}, "required": ["kind"]},
          "then": {"properties": {"value": {"minLength": 3, "maxLength": 8192, "allOf": [
            {"pattern": "^[^\\x00-\\x1F\\x7F]+$"},
            {"pattern": "([A-Za-z]|[^\\x00-\\x7F])"}
          ]}}}
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "url", "supports", "reviewed_at"],
      "properties": {
        "kind": {"const": "primary_vendor"},
        "url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "supports": {"type": "string", "minLength": 1},
        "reviewed_at": {"type": "string", "format": "date-time"}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "method", "reviewed_at", "artifact_version"],
      "properties": {
        "reference": {"type": "string", "minLength": 1},
        "method": {"enum": ["codesign_bundle_inspection", "authenticode_artifact_inspection"]},
        "reviewed_at": {"type": "string", "format": "date-time"},
        "artifact_version": {"type": "string", "minLength": 1},
        "code_directory_hash": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "oneOf": [
        {"required": ["code_directory_hash"], "not": {"required": ["artifact_sha256"]}},
        {"required": ["artifact_sha256"], "not": {"required": ["code_directory_hash"]}}
      ]
    }
  }
}
